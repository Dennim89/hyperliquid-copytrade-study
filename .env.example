# Optional settings for copytrade_hl.py and diag_abs_posthoc.py. Nothing here is secret:
# the study reads public data and needs no keys, wallets or accounts.
# The scripts read the process environment; to load this file in a POSIX shell:  set -a; . ./.env; set +a

# Folder that holds raw/ (API responses) and the report. Default: the folder of copytrade_hl.py.
HL_STUDY_ROOT=./study-data

# Public read-only endpoints. The values below are the defaults; change them only to point at a test server.
HL_API_URL=https://api.hyperliquid.xyz/info
HL_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
